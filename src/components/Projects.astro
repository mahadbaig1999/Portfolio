---
/**
 * Projects.astro — Portfolio project cards grid.
 *
 * Typography scaled up for optimal readability.
 */

import { portfolioData } from '../data/portfolio';
const { projects } = portfolioData;
---

<!-- ═══════════════════════════════════════════════════════════════════════
     PROJECTS SECTION
════════════════════════════════════════════════════════════════════════════ -->
<section
  id="projects"
  aria-labelledby="projects-heading"
  class="py-28 border-t border-gray-800/60"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">

    <!-- ── Section heading ───────────────────────────────────────────────── -->
    <div class="mb-16 text-center reveal">
      <p class="text-sm font-semibold tracking-widest text-amber-400 uppercase mb-3">
        My Work
      </p>
      <h2
        id="projects-heading"
        class="inline-block text-4xl sm:text-5xl font-extrabold tracking-tight text-white relative pb-3"
      >
        Featured Projects
        <!-- Amber to Orange gradient underline accent -->
        <span
          class="absolute bottom-0 left-0 h-1.5 w-full rounded-full bg-gradient-to-r from-amber-500 via-orange-400 to-yellow-400"
          aria-hidden="true"
        ></span>
      </h2>
      <p class="mt-6 max-w-2xl mx-auto text-base sm:text-lg text-gray-300">
        A selection of recent builds — responsive, accessible, and crafted with clean code.
      </p>
    </div>

    <!-- ── Project cards grid ──────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

      {projects.map((project, index) => (
        <article
          class="reveal group flex flex-col justify-between rounded-2xl border border-gray-800/90 bg-gray-900/40 p-7 sm:p-8 backdrop-blur-sm
                 transition-all duration-300
                 hover:-translate-y-2 hover:border-amber-500/50 hover:shadow-2xl hover:shadow-amber-500/15"
          style={`animation-delay: ${index * 100}ms`}
        >
          <!-- ── Card top: counter + featured badge ──────────────────────── -->
          <div>
            <div class="flex items-center justify-between mb-5">

              <span
                class="font-mono text-sm font-bold text-amber-400/90 tracking-wider"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>

              {project.featured && (
                <span
                  class="rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-300"
                  aria-label="Featured project"
                >
                  ★ Featured
                </span>
              )}
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-white transition-colors duration-200 group-hover:text-amber-400">
              {project.title}
            </h3>

            <p class="mt-3.5 text-base text-gray-300 leading-relaxed">
              {project.description}
            </p>
          </div>

          <!-- ── Card bottom: tech tags + links ──────────────────────────── -->
          <div class="mt-7 pt-5 border-t border-gray-800/80 space-y-5">

            <div class="flex flex-wrap gap-2" aria-label="Technologies used">
              {project.tags.map((tag) => (
                <span class="rounded-md border border-gray-700/60 bg-gray-800/70 px-3 py-1 text-xs sm:text-sm font-medium text-gray-300">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-4 pt-1">

              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-lg border border-amber-500/30 bg-amber-500/10 px-3.5 py-2 text-sm font-semibold text-amber-300 shadow-sm transition-all duration-200 hover:border-amber-400 hover:bg-amber-500/20 hover:text-white hover:-translate-y-0.5 hover:shadow-md hover:shadow-amber-500/20"
                  aria-label={`View live demo of ${project.title} (opens in new tab)`}
                >
                  <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  <span>Live Demo</span>
                </a>
              )}

              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-lg border border-gray-700 bg-gray-800/60 px-3.5 py-2 text-sm font-semibold text-gray-300 transition-all duration-200 hover:border-amber-500/50 hover:bg-gray-800 hover:text-amber-300 hover:-translate-y-0.5"
                  aria-label={`View source code for ${project.title} on GitHub (opens in new tab)`}
                >
                  <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                  <span>GitHub</span>
                </a>
              )}

              {!project.link && !project.github && (
                <span class="text-sm text-gray-500 italic">Links coming soon</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════
     SCROLL-REVEAL ANIMATION
════════════════════════════════════════════════════════════════════════════ -->
<style>
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const revealEls = document.querySelectorAll('#projects .reveal');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = parseFloat(el.style.animationDelay || '0');
          setTimeout(() => el.classList.add('visible'), delay);
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.1 }
  );

  revealEls.forEach((el) => observer.observe(el));
</script>
