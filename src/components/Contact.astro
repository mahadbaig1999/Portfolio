---
/**
 * Contact.astro — Contact / Connect section.
 *
 * WHAT'S HERE:
 *   • Section heading + subheading with larger, comfortable typography
 *   • Three contact channel cards: Email · LinkedIn · GitHub
 *   • Each entire card is a clean, prominent clickable card with hover effects
 *   • Bottom tabs and "open email client" text removed for a clean, cohesive card feel
 */

import { portfolioData } from '../data/portfolio';
const { contact } = portfolioData;
---

<!-- ═══════════════════════════════════════════════════════════════════════
     CONTACT / CONNECT SECTION
════════════════════════════════════════════════════════════════════════════ -->
<section
  id="contact"
  aria-labelledby="contact-heading"
  class="py-28 border-t border-gray-800/60"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">

    <!-- ── Section heading ───────────────────────────────────────────────── -->
    <div class="mb-16 text-center reveal">
      <p class="text-sm font-semibold tracking-widest text-amber-400 uppercase mb-3">
        Get In Touch
      </p>
      <h2
        id="contact-heading"
        class="inline-block text-4xl sm:text-5xl font-extrabold tracking-tight text-white relative pb-3"
      >
        {contact.heading}
        <!-- Amber/Orange gradient underline accent -->
        <span
          class="absolute bottom-0 left-0 h-1.5 w-full rounded-full bg-gradient-to-r from-amber-500 via-orange-400 to-yellow-400"
          aria-hidden="true"
        ></span>
      </h2>
      <p class="mt-6 max-w-xl mx-auto text-base sm:text-lg text-gray-300 leading-relaxed">
        {contact.subheading}
      </p>
    </div>

    <!-- ── Three contact channel cards ───────────────────────────────────────
         The entire cards are clickable links with clean centered content.
    ──────────────────────────────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">

      <!-- ══ Card 1: Email ══════════════════════════════════════════════════ -->
      <a
        href={`mailto:${contact.email}`}
        class="reveal group flex flex-col items-center justify-center rounded-2xl border border-amber-500/30 bg-amber-500/5 p-8 sm:p-9 text-center
               transition-all duration-300 hover:-translate-y-2 hover:border-amber-400 hover:bg-amber-500/10 hover:shadow-2xl hover:shadow-amber-500/20"
        aria-label="Send me an email (opens your email client)"
      >
        <!-- Icon badge -->
        <div
          class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-amber-500/30 bg-amber-500/20 text-amber-400
                 transition-all duration-300 group-hover:scale-110 group-hover:bg-amber-500/30 group-hover:text-amber-300"
          aria-hidden="true"
        >
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>

        <h3 class="text-xl font-bold text-white transition-colors duration-200 group-hover:text-amber-400">
          Email
        </h3>
        <p class="mt-2 text-base text-gray-300">
          Send me a direct message
        </p>
      </a>
      <!-- ══ END Email card ══════════════════════════════════════════════════ -->


      <!-- ══ Card 2: LinkedIn ════════════════════════════════════════════════ -->
      <a
        href={contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal group flex flex-col items-center justify-center rounded-2xl border border-gray-800 bg-gray-900/40 p-8 sm:p-9 text-center
               transition-all duration-300 hover:-translate-y-2 hover:border-amber-500/50 hover:bg-gray-900/70 hover:shadow-2xl hover:shadow-amber-500/15"
        aria-label="View LinkedIn profile (opens in new tab)"
      >
        <!-- LinkedIn icon badge -->
        <div
          class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-gray-700 bg-gray-800 text-gray-300
                 transition-all duration-300 group-hover:scale-110 group-hover:border-amber-500/40 group-hover:bg-amber-500/10 group-hover:text-amber-400"
          aria-hidden="true"
        >
          <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.39 9.74v-8.37H5.07v8.37h2.78z" />
          </svg>
        </div>

        <h3 class="text-xl font-bold text-white transition-colors duration-200 group-hover:text-amber-400">
          LinkedIn
        </h3>
        <p class="mt-2 text-base text-gray-300">
          Connect &amp; message professionally
        </p>
      </a>
      <!-- ══ END LinkedIn card ════════════════════════════════════════════════ -->


      <!-- ══ Card 3: GitHub ══════════════════════════════════════════════════ -->
      <a
        href={contact.github}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal group flex flex-col items-center justify-center rounded-2xl border border-gray-800 bg-gray-900/40 p-8 sm:p-9 text-center
               transition-all duration-300 hover:-translate-y-2 hover:border-amber-500/50 hover:bg-gray-900/70 hover:shadow-2xl hover:shadow-amber-500/15"
        aria-label="Visit GitHub profile (opens in new tab)"
      >
        <!-- GitHub icon badge -->
        <div
          class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-gray-700 bg-gray-800 text-gray-300
                 transition-all duration-300 group-hover:scale-110 group-hover:border-amber-500/40 group-hover:bg-amber-500/10 group-hover:text-amber-400"
          aria-hidden="true"
        >
          <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </div>

        <h3 class="text-xl font-bold text-white transition-colors duration-200 group-hover:text-amber-400">
          GitHub
        </h3>
        <p class="mt-2 text-base text-gray-300">
          Explore code &amp; repositories
        </p>
      </a>
      <!-- ══ END GitHub card ════════════════════════════════════════════════ -->

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════
     SCROLL-REVEAL
════════════════════════════════════════════════════════════════════════════ -->
<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const revealEls = document.querySelectorAll('#contact .reveal');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => entry.target.classList.add('visible'), i * 100);
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  revealEls.forEach((el) => revealObserver.observe(el));
</script>
