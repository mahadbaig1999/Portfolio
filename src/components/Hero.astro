---
/**
 * Hero.astro — Landing / Hero section.
 *
 * Typography has been scaled up for enhanced readability across all devices.
 */

import { portfolioData } from '../data/portfolio';
const { personal } = portfolioData;

const showAvailableBadge = true;
---

<section
  id="hero"
  aria-label="Introduction"
  class="relative overflow-hidden pt-24 pb-28 md:pt-32 md:pb-36"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col-reverse items-center justify-between gap-12 lg:flex-row lg:gap-20">

      <!-- ── LEFT: Text Content ───────────────────────────────────────────── -->
      <div class="flex-1 text-center lg:text-left">

        <!-- "Available" status badge -->
        {showAvailableBadge && (
          <div
            class="inline-flex items-center gap-2.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-2 text-sm font-semibold text-amber-400 mb-6"
            role="status"
            aria-label="Availability status"
          >
            <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
            <span>Available for New Opportunities</span>
          </div>
        )}

        <!-- ── Name (large, prominent) ──────────────────────────────────── -->
        <h1 class="text-5xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl text-white leading-tight">
          Hi, I'm{' '}
          <span class="bg-gradient-to-r from-amber-400 via-orange-300 to-yellow-400 bg-clip-text text-transparent">
            {personal.name}
          </span>
        </h1>

        <!-- ── Title (role / profession) ────────────────────────────────── -->
        <p class="mt-4 text-2xl sm:text-3xl lg:text-4xl font-semibold text-gray-200">
          {personal.title}
        </p>

        <!-- ── Tagline (short motto) ─────────────────────────────────────── -->
        <p class="mt-3 text-xl sm:text-2xl font-bold tracking-widest text-amber-400 uppercase">
          "{personal.tagline}"
        </p>

        <!-- ── Subtitle / description ─────────────────────────────────────── -->
        <p class="mt-6 max-w-2xl text-lg sm:text-xl text-gray-300 leading-relaxed mx-auto lg:mx-0">
          {personal.subtitle}
        </p>

        <!-- ── Action Buttons ──────────────────────────────────────────────── -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-5 lg:justify-start">

          <!-- Primary CTA: View Projects -->
          <a
            href="#projects"
            class="group inline-flex items-center gap-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 px-7 py-4 text-base font-semibold text-white shadow-lg shadow-amber-500/25 transition-all duration-200 hover:from-amber-400 hover:to-orange-400 hover:shadow-amber-500/40 hover:-translate-y-0.5"
          >
            <span>View Projects</span>
            <svg
              class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1"
              fill="none" viewBox="0 0 24 24" stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Secondary CTA: Contact Me -->
          <a
            href="#contact"
            class="inline-flex items-center gap-2.5 rounded-xl border border-amber-500/40 bg-amber-500/5 px-7 py-4 text-base font-semibold text-amber-300 backdrop-blur-sm transition-all duration-200 hover:border-amber-400/60 hover:bg-amber-500/10 hover:text-white hover:-translate-y-0.5"
          >
            <span>Contact Me</span>
            <svg
              class="h-5 w-5"
              fill="none" viewBox="0 0 24 24" stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>
      <!-- ── END: Left Text Content ──────────────────────────────────────── -->


      <!-- ── RIGHT: Avatar ───────────────────────────────────────────────── -->
      <div class="flex-shrink-0 flex flex-col items-center">
        <div class="relative group">
          <div
            class="absolute -inset-2 rounded-full bg-gradient-to-r from-amber-500 via-orange-500 to-yellow-500 opacity-50 blur-xl transition duration-500 group-hover:opacity-80"
            aria-hidden="true"
          ></div>

          <div class="relative h-64 w-64 sm:h-72 sm:w-72 rounded-full p-2 bg-[#0b0f19] ring-2 ring-gray-800 shadow-2xl">
            <img
              src={personal.avatar}
              alt={`Portrait of ${personal.name}`}
              width="288"
              height="288"
              class="h-full w-full rounded-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <p class="mt-4 text-base font-semibold text-gray-400 tracking-wide lg:hidden">
          {personal.name}
        </p>
      </div>
      <!-- ── END: Right Avatar ───────────────────────────────────────────── -->

    </div>
  </div>
</section>
